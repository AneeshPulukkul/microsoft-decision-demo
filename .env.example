# Foundry resource endpoint from the deployment details page.
# Any of these forms work; the client adds the missing /v1/systemone part.
#   https://your-resource.cognitiveservices.azure.com/
#   https://your-resource.services.ai.azure.com/
#   https://your-resource.services.ai.azure.com/providers/microsoft
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# Name you gave the Microsoft-Decision-1.1 deployment.
DEPLOYMENT_NAME=microsoft-decision-1.1

# Auth option 1: API key from the deployment details page.
AZURE_API_KEY=replace-me

# Auth option 2: leave AZURE_API_KEY empty and provide an Entra ID token.
# AZURE_ENTRA_TOKEN=

# Optional: list price used only for the cost estimate.
DECISION_PRICE_PER_M_INPUT=0.042

# Set to 1 to run the whole demo offline with a deterministic stub.
DECISION_MOCK=0

# Optional server settings.
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=https://your-frontend.example.com
# RATE_LIMIT_PER_MIN=20
